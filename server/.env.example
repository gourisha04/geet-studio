# Server Configuration
PORT=5000
NODE_ENV=development

# CORS — every frontend origin must be listed explicitly (no wildcards).
# CLIENT_URL: primary frontend origin (production Vercel URL, or http://localhost:5173 locally).
# CORS_ALLOWED_ORIGINS: optional extra origins, comma-separated (Vercel previews, staging, custom domains).
CLIENT_URL=http://localhost:5173
# Example: https://geet-studio.vercel.app,https://geet-studio-git-preview.vercel.app
CORS_ALLOWED_ORIGINS=

# MongoDB Atlas Connection
MONGODB_URI=your_mongodb_atlas_connection_string

# Authentication Secrets
JWT_SECRET=your_jwt_secret
COOKIE_SECRET=your_cookie_secret

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Bootstrap (used only to create the initial admin; existing passwords are never reset)
ADMIN_EMAIL=geetdancestudio@gmail.com
ADMIN_SEED_PASSWORD=arpit_2000